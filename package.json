{
  "name": "bizsolve-ai",
  "version": "1.0.0",
  "private": true,
  "description": "BizSolve AI - AI-powered business problem solver for small business owners",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-server/index.js --external:better-sqlite3 --log-level=warning",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.6"
  }
}
