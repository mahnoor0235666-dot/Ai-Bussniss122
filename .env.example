# ---------------------------------------------------------------------------
# BizSolve AI - example environment file
# Copy to .env and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
# Where the SQLite database file lives (created automatically).
DATABASE_FILE=./data/bizsolve.db
# Set to 1 when running behind a reverse proxy (Render/Fly/Nginx) so rate
# limiting sees the real client IP and secure cookies work.
TRUST_PROXY=0
# Force the Secure flag on the session cookie (auto-enabled when NODE_ENV=production)
COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# AI provider (OpenAI-compatible Chat Completions API).
# Without AI_API_KEY the AI features show a clear "not configured" message and
# every non-AI feature keeps working. No answers are ever fabricated.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=1800
# Per-user rolling 24h AI request quota
AI_DAILY_LIMIT=25

# ---------------------------------------------------------------------------
# Transactional email (Resend HTTP API) for password reset + verification.
# Without it, password reset links are not delivered by email; in non-production
# the reset link is returned to the browser so the flow stays testable.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=BizSolve AI <no-reply@example.com>
APP_BASE_URL=http://localhost:3000
